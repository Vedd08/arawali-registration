# Copy this file to ".env" and fill in the values. Restart the server after changing it.
# On Render, add the same two values under the service's Environment tab instead.

# Neon database connection string (Neon dashboard > Connect). Starts with postgresql://
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Password for the admin page (/admin)
ADMIN_KEY=change-me

# The staff password employees sign in with is set on the admin page.

# Optional
# PORT=4500
